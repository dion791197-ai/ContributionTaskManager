<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GitHubGoal.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:util="using:GitHubGoal.Utilities">

    <Grid x:Name="RootGrid">

        <!-- ================= the glass card ================= -->
        <Border x:Name="GlassCard"
                CornerRadius="16"
                Background="{ThemeResource GlassCardBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource GlassBorderBrush}">

            <Grid>
                <!-- Specular sweep. Sits above the tint, below the content, and is
                     never hit-testable so it cannot swallow clicks. -->
                <Border CornerRadius="15"
                        IsHitTestVisible="False"
                        Background="{ThemeResource GlassSheenBrush}" />

                <!-- Completion glow: a green rim that fades in when the goal is met. -->
                <Border x:Name="CompletionGlow"
                        CornerRadius="15"
                        IsHitTestVisible="False"
                        Opacity="0"
                        BorderThickness="1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#B33FB950" />
                            <GradientStop Offset="0.5" Color="#4D3FB950" />
                            <GradientStop Offset="1" Color="#1A3FB950" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,1.05" RadiusX="0.85" RadiusY="0.7">
                                <GradientStop Offset="0" Color="#382EA043" />
                                <GradientStop Offset="1" Color="#002EA043" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <!-- ================= content ================= -->
                <Grid Padding="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ================= header ================= -->
                    <Grid x:Name="HeaderBar" Grid.Row="0" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar, falling back to a person glyph before sign-in. -->
                        <Border Grid.Column="0"
                                Width="22" Height="22"
                                CornerRadius="11"
                                VerticalAlignment="Center"
                                Background="{ThemeResource TrackBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE77B;"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextMutedBrush}" />
                                <Image Source="{x:Bind util:Show.Avatar(ViewModel.AvatarUrl), Mode=OneWay}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   Text="{x:Bind ViewModel.UserLogin, Mode=OneWay, FallbackValue='GitHub'}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button x:Name="RefreshButton"
                                    Style="{StaticResource GlassIconButtonStyle}"
                                    Command="{x:Bind ViewModel.RefreshCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}"
                                    AutomationProperties.Name="Refresh contributions"
                                    ToolTipService.ToolTip="Refresh">
                                <FontIcon x:Name="RefreshGlyph"
                                          Glyph="&#xE72C;"
                                          FontSize="13"
                                          RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform x:Name="RefreshRotation" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Button>

                            <Button Style="{StaticResource GlassIconButtonStyle}"
                                    Click="OnSettingsClick"
                                    AutomationProperties.Name="Open settings"
                                    ToolTipService.ToolTip="Settings">
                                <FontIcon Glyph="&#xE713;" FontSize="13" />
                            </Button>

                            <Button Style="{StaticResource GlassIconButtonStyle}"
                                    Click="OnHideClick"
                                    AutomationProperties.Name="Hide widget to the notification area"
                                    ToolTipService.ToolTip="Hide to tray">
                                <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ================= signed-in body ================= -->
                    <Grid Grid.Row="1"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind util:Show.When(ViewModel.ShowsWidgetContent), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- The headline: count, goal and percentage on one baseline. -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="CountLabel"
                                           Text="0"
                                           FontSize="42"
                                           FontWeight="SemiBold"
                                           LineHeight="46"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           AutomationProperties.Name="Contributions today" />
                                <TextBlock Margin="7,0,0,7"
                                           VerticalAlignment="Bottom"
                                           FontSize="17"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource TextGoalBrush}"
                                           Text="{x:Bind ViewModel.GoalText, Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock x:Name="PercentLabel"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,7"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="0%"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="0,1,0,0"
                                   FontSize="12"
                                   Text="Contributions today"
                                   Foreground="{ThemeResource TextMutedBrush}" />

                        <!-- Progress bar. The fill is scaled rather than resized so the
                             animation runs on the composition thread. -->
                        <Border Grid.Row="2"
                                Margin="0,13,0,0"
                                Height="7"
                                CornerRadius="3.5"
                                Background="{ThemeResource TrackBrush}">
                            <Border x:Name="ProgressFill"
                                    CornerRadius="3.5"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource ProgressFillBrush}"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>

                        <!-- Remaining / completed line, with the completion tick. -->
                        <StackPanel Grid.Row="3"
                                    Margin="0,11,0,0"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource AccentBrush}"
                                      Visibility="{x:Bind util:Show.When(ViewModel.IsGoalComplete), Mode=OneWay}" />
                            <TextBlock FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Footer: freshness, plus a warning dot when data is stale. -->
                        <StackPanel Grid.Row="4"
                                    Margin="0,7,0,0"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            <Ellipse Width="5" Height="5"
                                     VerticalAlignment="Center"
                                     Fill="#E3B341"
                                     Visibility="{x:Bind util:Show.When(ViewModel.HasWarning), Mode=OneWay}" />
                            <TextBlock FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       Text="{x:Bind ViewModel.UpdatedText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- ================= signed-out / device flow ================= -->
                    <Grid Grid.Row="1"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind util:Show.Unless(ViewModel.ShowsWidgetContent), Mode=OneWay}">
                        <StackPanel Spacing="9">

                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       Text="Track your daily goal" />

                            <!-- The fallback text deliberately avoids an apostrophe: the
                                 XAML parser expands entities before parsing the markup
                                 extension, so one would terminate the quoted literal. -->
                            <TextBlock FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       Text="{x:Bind ViewModel.AuthStatus, Mode=OneWay, FallbackValue='Connect your GitHub account to track daily contributions.'}" />

                            <!-- The device code, shown once GitHub issues one. -->
                            <Border Padding="10,7"
                                    CornerRadius="8"
                                    Background="{ThemeResource TrackBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource DividerBrush}"
                                    Visibility="{x:Bind util:Show.WhenPresent(ViewModel.UserCode), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               FontFamily="Consolas"
                                               IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               Text="{x:Bind ViewModel.UserCode, Mode=OneWay}" />
                                    <HyperlinkButton Padding="0"
                                                     VerticalAlignment="Center"
                                                     FontSize="11.5"
                                                     Content="Open github.com/login/device"
                                                     Click="OnVerificationLinkClick" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Button Content="Sign in with GitHub"
                                        FontSize="12"
                                        Padding="12,5"
                                        CornerRadius="7"
                                        Command="{x:Bind ViewModel.SignInCommand}"
                                        Visibility="{x:Bind util:Show.Unless(ViewModel.IsAuthorizing), Mode=OneWay}" />

                                <Button Content="Cancel"
                                        FontSize="12"
                                        Padding="12,5"
                                        CornerRadius="7"
                                        Command="{x:Bind ViewModel.CancelSignInCommand}"
                                        Visibility="{x:Bind util:Show.When(ViewModel.IsAuthorizing), Mode=OneWay}" />

                                <Button Content="Settings"
                                        FontSize="12"
                                        Padding="12,5"
                                        CornerRadius="7"
                                        Click="OnSettingsClick" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
